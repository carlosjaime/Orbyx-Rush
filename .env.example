# ---------------------------------------------------------------------------
# Orbyx Rush - environment variables
# ---------------------------------------------------------------------------
# The first public release is fully offline and needs NO secrets to run.
# Every variable below is optional and only unlocks future integrations.
# Copy this file to `.env.local` and fill in the values you need.
# Only NEXT_PUBLIC_* variables reach the browser bundle (static export).
# ---------------------------------------------------------------------------

# Public site URL, used for Open Graph / canonical metadata.
NEXT_PUBLIC_SITE_URL=https://orbyx-rush.vercel.app

# Build/version label shown in the credits screen and used to bust the SW cache.
NEXT_PUBLIC_APP_VERSION=1.0.0

# Enables the in-game debug panel outside of development builds.
# Never enable this for a store build. Accepted values: "true" | "false".
NEXT_PUBLIC_ENABLE_DEBUG=false

# Forces a deterministic seed for every run (QA / reproducible sessions).
# Leave empty for normal random gameplay.
NEXT_PUBLIC_FORCED_SEED=

# Analytics provider selector for the AnalyticsAdapter. Default: "noop".
# Accepted values: "noop" | "console".
NEXT_PUBLIC_ANALYTICS_PROVIDER=noop

# Future remote leaderboard endpoint. Unused in v1.0.0 (local leaderboard only).
NEXT_PUBLIC_LEADERBOARD_ENDPOINT=
