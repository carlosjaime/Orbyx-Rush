{
  "name": "orbyx-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Orbyx Rush - Arcade orbital 2D game. Developed by DevHive Software.",
  "author": "DevHive Software",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:e2e:ui": "pnpm build:e2e && playwright test --ui",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "mobile:sync": "next build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:build:android": "next build && cap sync android && cap open android",
    "mobile:build:ios": "next build && cap sync ios && cap open ios",
    "build:e2e": "cross-env NEXT_PUBLIC_ENABLE_DEBUG=true NEXT_PUBLIC_FORCED_SEED=E2ESEED01 next build",
    "assets:generate": "node scripts/generate-native-assets.mjs",
    "mobile:assets": "node scripts/generate-native-assets.mjs && cap sync"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "next": "16.2.12",
    "phaser": "3.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "sharp",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
