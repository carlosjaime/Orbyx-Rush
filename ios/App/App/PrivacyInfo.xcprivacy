<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Orbyx Rush privacy manifest.

  The app collects no data at all: no accounts, no analytics, no advertising
  identifiers and no network calls to a game backend. The only declared
  required-reason API is UserDefaults, which Capacitor's Preferences plugin and
  the WebView use to store the player's own settings on device.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access limited to app-owned settings and progress. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
